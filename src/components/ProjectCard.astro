---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<article class="group border-t-2 border-black pt-5">
  <div class="mb-12 flex items-start justify-between gap-6">
    <span class="font-display text-4xl font-bold leading-none text-[#FF0000]">{number}</span>
    <a href="#" class="text-sm font-bold uppercase tracking-[0.08em] underline decoration-2 underline-offset-4 transition-colors hover:text-[#FF0000]" aria-label={`View ${title}`}>
      View project
    </a>
  </div>
  <h2 class="font-display text-4xl font-bold uppercase leading-[0.9] tracking-tight sm:text-5xl">{title}</h2>
  <p class="mt-5 max-w-sm text-lg leading-relaxed">{description}</p>
</article>
