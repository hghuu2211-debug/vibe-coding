---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-black bg-black text-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
    <a href="/" class="font-display text-3xl font-bold uppercase leading-none tracking-tight text-white" aria-label="Hoang Ba Huu home">
      HBH
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-5 text-sm font-bold uppercase tracking-[0.08em] sm:gap-8">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'nav-magnetic relative inline-block transition-colors hover:text-[#FF0000]',
                currentPath === link.href ? 'text-[#FF0000]' : 'text-white',
              ]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-magnetic::after {
    position: absolute;
    inset: -10px -14px;
    border: 2px solid #ff0000;
    background: transparent;
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scale(1.16);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .nav-magnetic:hover::after {
    opacity: 1;
    transform: scale(1);
  }
</style>
