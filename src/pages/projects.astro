---
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Projects - Hoang Ba Huu">
  <section class="mx-auto max-w-7xl px-6 pb-20 pt-20 lg:px-10 lg:pb-32 lg:pt-32">
    <p class="mb-7 text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">Selected projects</p>
    <h1 class="mx-auto max-w-5xl text-center font-display text-[clamp(4.5rem,13vw,11rem)] font-bold uppercase leading-[0.78] tracking-[-0.04em]">Work that<br /><span class="text-[#FF0000]">travels.</span></h1>
    <p class="mt-12 max-w-xl text-xl leading-relaxed sm:text-2xl">A few experiments, publications, and collaborations built around a simple question: can this be more useful?</p>
  </section>

  <section class="border-y-2 border-black px-6 py-16 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-4">
      <ProjectCard number="01" title="The Sunday Signal" description="A weekly note about attention, creativity, and living deliberately online." />
      <ProjectCard number="02" title="Field Notes" description="A growing archive of conversations with people making meaningful things." />
      <ProjectCard number="03" title="Common Ground" description="A collaborative guide to clearer communication for modern teams." />
      <ProjectCard number="04" title="Small Hours" description="A quiet digital space for collecting thoughts before they disappear." />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28"><p class="mb-5 text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">More in your inbox</p><h2 class="mb-8 max-w-2xl font-display text-5xl font-bold uppercase leading-[0.85] sm:text-7xl">Come along<br />for the process.</h2><NewsletterForm compact /></section>
</Layout>
