---
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Layout>
  <section class="mx-auto max-w-7xl px-6 pb-28 pt-20 lg:px-10 lg:pb-40 lg:pt-32">
    <p class="mb-7 text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">Writer / builder / curious human</p>
    <h1 class="mx-auto max-w-5xl text-center font-display text-[clamp(4.5rem,14vw,12rem)] font-bold uppercase leading-[0.78] tracking-[-0.04em]">
      Make useful<br /><span class="text-[#FF0000]">things.</span>
    </h1>
    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-end">
      <p class="max-w-md text-xl leading-relaxed sm:text-2xl">I'm Hoang Ba Huu. I write about the work, ideas, and habits that help us make a little more sense of the world.</p>
      <div>
        <p class="mb-4 font-display text-3xl font-bold uppercase leading-none">Get the good stuff weekly.</p>
        <NewsletterForm />
      </div>
    </div>
  </section>

  <section class="border-y-2 border-black bg-black px-6 py-16 text-white lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:gap-24">
      <div>
        <h2 class="max-w-lg text-left font-display text-6xl font-bold uppercase leading-[0.85] text-[#FF0000] sm:text-8xl">A human<br />behind the work.</h2>
      </div>
      <div class="flex flex-col items-start justify-between gap-8">
        <p class="max-w-lg text-xl leading-relaxed">Part strategist, part storyteller, part perpetual student. I care about clear thinking and work that earns attention by being genuinely useful.</p>
        <a href="/about" class="border-b-2 border-[#FF0000] pb-2 font-bold uppercase tracking-[0.08em] text-white transition-colors hover:text-[#FF0000]">More about Huu <span aria-hidden="true">-&gt;</span></a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-32">
    <div class="mb-12 flex items-end justify-between gap-6">
      <div>
        <h2 class="text-left font-display text-6xl font-bold uppercase leading-[0.85] text-[#FF0000] sm:text-8xl">Things are<br />made.</h2>
      </div>
      <a href="/projects" class="hidden border-b-2 border-black pb-2 text-sm font-bold uppercase tracking-[0.08em] transition-colors hover:border-[#FF0000] hover:text-[#FF0000] sm:block">See everything <span aria-hidden="true">-&gt;</span></a>
    </div>
    <div class="grid gap-12 sm:grid-cols-2">
      <article class="border-t-2 border-black pt-5"><p class="font-display text-3xl font-bold uppercase">The Sunday Signal</p><p class="mt-3 max-w-sm text-lg leading-relaxed">A weekly note on paying attention in a distracted world.</p></article>
      <article class="border-t-2 border-black pt-5"><p class="font-display text-3xl font-bold uppercase">Field Notes</p><p class="mt-3 max-w-sm text-lg leading-relaxed">Conversations with people making meaningful things.</p></article>
    </div>
  </section>
</Layout>
