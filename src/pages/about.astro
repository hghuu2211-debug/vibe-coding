---
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<Layout title="About Hoang Ba Huu - Writer, Builder, Human">
  <section class="mx-auto max-w-7xl px-6 pb-20 pt-20 lg:px-10 lg:pb-32 lg:pt-32">
    <p class="mb-7 text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">About Hoang</p>
    <h1 class="mx-auto max-w-5xl text-center font-display text-[clamp(4.5rem,13vw,11rem)] font-bold uppercase leading-[0.78] tracking-[-0.04em]">Keep<br /><span class="text-[#FF0000]">looking.</span></h1>
  </section>

  <section class="border-y-2 border-black px-6 py-16 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-[0.8fr_1.2fr]">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">01 / Background</p>
      <div class="space-y-8 text-xl leading-relaxed sm:text-2xl">
        <p>I am a writer, builder, and lifelong learner interested in the space where good ideas become useful work. My path has moved through creative studios, early-stage teams, and a lot of notebooks.</p>
        <p>This is the short version. The longer version is still being written, one project and conversation at a time.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-16 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:px-10 lg:py-32">
    <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">02 / Highlights</p>
    <div class="grid gap-10 sm:grid-cols-2">
      <div class="border-t-2 border-black pt-5"><p class="font-display text-6xl font-bold leading-none">10+</p><p class="mt-3 text-lg">Years making things</p></div>
      <div class="border-t-2 border-black pt-5"><p class="font-display text-6xl font-bold leading-none">100s</p><p class="mt-3 text-lg">Ideas sent into the world</p></div>
      <div class="border-t-2 border-black pt-5"><p class="font-display text-6xl font-bold leading-none">01</p><p class="mt-3 text-lg">Weekly newsletter</p></div>
      <div class="border-t-2 border-black pt-5"><p class="font-display text-6xl font-bold leading-none">∞</p><p class="mt-3 text-lg">Questions still open</p></div>
    </div>
  </section>

  <section class="bg-black px-6 py-16 text-white lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">03 / Current work</p>
      <div><h2 class="font-display text-6xl font-bold uppercase leading-[0.85] sm:text-8xl">What's<br />next?</h2><p class="mt-8 max-w-lg text-xl leading-relaxed">Right now I am exploring independent publishing, small digital products, and the systems that help creative people do their best work.</p></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28"><p class="mb-5 text-sm font-bold uppercase tracking-[0.14em] text-[#FF0000]">Stay in the loop</p><h2 class="mb-8 max-w-2xl font-display text-5xl font-bold uppercase leading-[0.85] sm:text-7xl">One useful email.<br />Every week.</h2><NewsletterForm compact /></section>
</Layout>
